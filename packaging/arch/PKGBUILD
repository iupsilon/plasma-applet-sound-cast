# Maintainer: Yari Melzani <yari.melzani@gmail.com>
pkgname=plasma6-applets-sound-cast
pkgver=0.1.0
pkgrel=1
pkgdesc="Plasma 6 widget for sound-cast: status, device switching and event log"
arch=(any)
url="https://github.com/iupsilon/plasma-applet-sound-cast"
license=(GPL-3.0-or-later)
# python and libpulse (pactl) are used by sound-cast-move.
depends=(sound-cast python plasma-workspace plasma-pa plasma5support libpulse systemd)
makedepends=(git gettext make)
source=("git+$url.git#tag=v$pkgver")
sha256sums=(SKIP)

package() {
  cd plasma-applet-sound-cast
  make install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
